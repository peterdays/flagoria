 "structures": {
  "archer_post": {
   "footprint": [
    1,
    1
   ],
   "anchor": [
    0,
    0
   ],
   "suggested_cost": "6 wood (suggestion, IDEAS.md)",
   "rules": "Only on a wall cell whose solved shape is H or V (stone WALL_* or PALISADE_*). Replaces that cell: WALL_H -> ARCHER_POST_STONE_H, WALL_V -> ARCHER_POST_STONE_V, PALISADE_H/V -> ARCHER_POST_PALISADE_H/V. Counts as a wall neighbour of its own kind (stone / palisade) for masks, enclosures, cities and C2 collar caps. A later wall that would turn the cell into a corner, T, cross or end is refused (\"archer post\") rather than silently removing the post."
  },
  "neutral_outpost": {
   "footprint": [
    5,
    4
   ],
   "anchor": [
    2,
    3
   ],
   "suggested_cost": "world-gen only (suggestion, IDEAS.md)",
   "rules": "guard_post layout (T###T / #...# / #.F.# / ##G##) placed by world gen, one per island. After the wall solver, map each WALL_<shape> to WALL_MOSS_<shape> (all solved shapes of this layout exist). Optionally one N/S straight cell becomes WALL_MOSS_H_BREACH and one W/E straight cell WALL_MOSS_V_DMG_CRACK (seeded). The flag is PROP_FLAG_GREY (team); on capture it swaps to PROP_FLAG_BLUE/RED like any flag tower. Moss stays after capture. STONES on a cell next to the breach."
  },
  "barracks": {
   "footprint": [
    3,
    2
   ],
   "anchor": [
    1,
    1
   ],
   "suggested_cost": "25 wood (suggestion, IDEAS.md)",
   "rules": "All 6 cells walkable free land (no water, structure, plant, stump, mob or player); the cell below the anchor (door) must be walkable and is kept free. Team cells: column 1 (crest and door banners)."
  },
  "respawn_camp": {
   "footprint": [
    2,
    2
   ],
   "anchor": [
    0,
    1
   ],
   "suggested_cost": "12 wood (suggestion, IDEAS.md)",
   "rules": "All 4 cells walkable free land; the respawn point is the cell below the anchor (in front of the tent door), which must be walkable and is kept free. Tent cells carry team colour."
  },
  "trading_post": {
   "footprint": [
    2,
    2
   ],
   "anchor": [
    0,
    1
   ],
   "suggested_cost": "world-gen, or 15 wood (suggestion, IDEAS.md)",
   "rules": "All 4 cells walkable free land; the trader NPC stands on the cell below the anchor, facing the counter. Neutral (no team cells)."
  },
  "lumber_mill": {
   "footprint": [
    3,
    2
   ],
   "anchor": [
    1,
    1
   ],
   "suggested_cost": "20 wood (suggestion, IDEAS.md)",
   "rules": "All 6 cells walkable free land; cell below the anchor kept free. Neutral colours (no team cells)."
  },
  "watchtower": {
   "footprint": [
    1,
    1
   ],
   "anchor": [
    0,
    0
   ],
   "suggested_cost": "8 wood (suggestion, IDEAS.md)",
   "rules": "WATCHTOWER_BASE on a walkable free land cell (collides). WATCHTOWER_TOP_<team> on the cell above, no collision, like TREE_*_TOP; that cell must have nothing on layer 1 (no wall, tree, bush or other structure)."
  },
  "sky_dock": {
   "footprint": [
    2,
    2
   ],
   "anchor": "the ROOT cell",
   "suggested_cost": "15 wood (suggestion, IDEAS.md)",
   "rules": "Coast-edge only. Pick direction d where the root is a walkable land cell and the cell beyond it in d is water: SKY_DOCK_<d>_ROOT on the root (walkable, no collision), SKY_DOCK_<d>_END on that water cell, SKY_SKIFF_<team> on the water cell beside the end (E of it for N/S docks, S of it for E/W docks); both must be water. The fourth cell of the 2x2 is left as it is. Layer 1, ground stays as generated (coast art shows under the deck). Board/travel by tapping the skiff in interact mode from the root."
  }
